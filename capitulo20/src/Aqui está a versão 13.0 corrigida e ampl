3. SCRIPTS DE BANCO DE DADOS – PostgreSQL (Versão 13.0 Completa)
SQL-- =====================================================
-- STAYHUB - SCHEMA POSTGRESQL - Versão 13.0
-- Inclui: usuários com roles, listings, bookings, dynamic pricing, smart lock, experiências
-- =====================================================

-- 1. Usuários (Guest + Host na mesma tabela)
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    phone VARCHAR(30),
    profile_photo TEXT,
    role TEXT CHECK (role IN ('guest', 'host', 'both')) DEFAULT 'guest',
    is_superhost BOOLEAN DEFAULT FALSE,
    is_green_badge BOOLEAN DEFAULT FALSE,
    response_rate DECIMAL(5,2) DEFAULT 0,
    identity_verified BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Anúncios (Listings)
CREATE TABLE listings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    host_id UUID REFERENCES users(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    property_type VARCHAR(50) NOT NULL, -- casa inteira, quarto privativo...
    room_type VARCHAR(50),
    address TEXT NOT NULL,
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8),
    max_guests INT NOT NULL,
    bedrooms INT,
    beds INT,
    bathrooms INT,
    price_per_night DECIMAL(10,2) NOT NULL,
    cleaning_fee DECIMAL(10,2) DEFAULT 0,
    service_fee_percent DECIMAL(5,2) DEFAULT 12.0, -- comissão StayHub
    minimum_nights INT DEFAULT 1,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Comodidades (Amenities) - Many-to-Many
CREATE TABLE amenities (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) UNIQUE NOT NULL, -- Wi-Fi rápido, piscina, EV charger, pet-friendly...
    icon TEXT
);

CREATE TABLE listing_amenities (
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    amenity_id UUID REFERENCES amenities(id) ON DELETE CASCADE,
    PRIMARY KEY (listing_id, amenity_id)
);

-- 4. Reservas (Bookings)
CREATE TABLE bookings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    guest_id UUID REFERENCES users(id),
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    check_in DATE NOT NULL,
    check_out DATE NOT NULL,
    num_guests INT NOT NULL,
    total_price DECIMAL(10,2) NOT NULL,
    status TEXT CHECK (status IN ('pending', 'confirmed', 'cancelled', 'completed')) DEFAULT 'pending',
    cancellation_policy TEXT, -- flexible, moderate, strict, dynamic
    smart_lock_code TEXT,     -- código gerado para check-in digital
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 5. Pagamentos
CREATE TABLE payments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    booking_id UUID REFERENCES bookings(id),
    amount DECIMAL(10,2) NOT NULL,
    payment_method VARCHAR(50), -- pix, card, boleto
    status TEXT CHECK (status IN ('pending', 'paid', 'refunded', 'failed')),
    transaction_id TEXT,
    payout_to_host DECIMAL(10,2),
    paid_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 6. Avaliações (Reviews)
CREATE TABLE reviews (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    booking_id UUID REFERENCES bookings(id),
    reviewer_id UUID REFERENCES users(id),
    listing_id UUID REFERENCES listings(id),
    rating INT CHECK (rating BETWEEN 1 AND 5) NOT NULL,
    comment TEXT,
    photos TEXT[], -- array de URLs de fotos
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 7. Mensagens
CREATE TABLE messages (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    booking_id UUID REFERENCES bookings(id),
    sender_id UUID REFERENCES users(id),
    receiver_id UUID REFERENCES users(id),
    content TEXT NOT NULL,
    is_read BOOLEAN DEFAULT FALSE,
    sent_at TIMESTAMPTZ DEFAULT NOW()
);

-- 8. Calendário / Disponibilidade e Bloqueios
CREATE TABLE availability_blocks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    reason TEXT, -- manutenção, viagem, bloqueio manual
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 9. Histórico de Preços Dinâmicos (Dynamic Pricing)
CREATE TABLE price_history (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    date DATE NOT NULL,
    price DECIMAL(10,2) NOT NULL,
    suggested_by_ai BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- 10. Wishlists / Favoritos
CREATE TABLE wishlists (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE wishlist_items (
    wishlist_id UUID REFERENCES wishlists(id) ON DELETE CASCADE,
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    PRIMARY KEY (wishlist_id, listing_id)
);

-- 11. Co-Anfitriões
CREATE TABLE co_hosts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    listing_id UUID REFERENCES listings(id) ON DELETE CASCADE,
    user_id UUID REFERENCES users(id),
    permissions TEXT[], -- array: ['calendar', 'pricing', 'messages']
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Índices de performance (essenciais para busca e calendário)
CREATE INDEX idx_listings_location ON listings USING GIST (point(latitude, longitude));
CREATE INDEX idx_bookings_dates ON bookings (check_in, check_out);
CREATE INDEX idx_listings_price ON listings (price_per_night);
CREATE INDEX idx_reviews_listing ON reviews(listing_id);
CREATE INDEX idx_availability_listing ON availability_blocks(listing_id, start_date, end_date);

-- Triggers para atualizar updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_users_updated_at BEFORE UPDATE ON users FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER update_listings_updated_at BEFORE UPDATE ON listings FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
Observações do schema:

Suporta dynamic pricing (tabela price_history)
Suporta smart lock (campo smart_lock_code na reserva)
Suporta experiences locais (pode ser expandido com tabela experiences)
Preparado para busca geoespacial e calendário sem conflitos


4. DIAGRAMAS TEXTUAIS
4.1 ER Diagram Simplificado (Texto)
textUsers (id, email, role, is_superhost)
   ├── hosts → Listings (id, host_id, title, price_per_night, latitude, longitude)
   │             ├── many-to-many → Amenities
   │             ├── one-to-many → Availability_Blocks
   │             ├── one-to-many → Price_History
   │             └── one-to-many → Co_Hosts
   │
   └── guests → Bookings (id, guest_id, listing_id, check_in, check_out, total_price, status, smart_lock_code)
                  ├── one-to-one → Payments
                  ├── one-to-many → Messages
                  └── one-to-many → Reviews (reviewer_id, listing_id, rating, photos)
4.2 Diagrama de Sequência – Fluxo de Reserva (Principal)
textHóspede → App → Busca Anúncio → Detalhe → Escolhe Datas → Calcula Preço Total
   ↓
Sistema → Verifica Disponibilidade (listings + availability_blocks)
   ↓ (disponível)
Hóspede → Aceita Regras + Escolhe Pagamento → Confirma
   ↓
Sistema → Processa Pagamento (Payments) → Cria Booking (status=confirmed)
   ↓
Sistema → Gera Smart Lock Code → Envia Notificação + E-mail
   ↓
Anfitrião → Recebe Notificação → Pode ver na aba Reservas
4.3 Diagrama de Sequência – Dynamic Pricing (Anfitrião)
textSistema (IA) → Analisa demanda local + eventos + histórico → Sugere preço
   ↓
Anfitrião → Aprova ou edita preço → Salva em price_history
   ↓
Sistema → Atualiza preço_per_night ou aplica por data
   ↓
Hóspede (futuro) → Vê preço atualizado na busca/detalhe

