# =============================================================
# rust_estudo — regras globais para todos os crates Cargo
# piloto-rust, pulsar, capitulo20, tutorialpoint/*, etc.
# matrix-novo-exemplo-palm-pay.tar.gz permanece versionado
# =============================================================

# ===============================
# Rust / Cargo
# ===============================
**/target/
**/*.rs.bk
**/*.pdb
# Cargo.lock: binários → ignore; libs → pode versionar
**/Cargo.lock

# Binários compilados fora de target/ (ex.: src/main sem .rs)
**/src/main

# SQLx (cache offline de queries)
**/.sqlx/

# Profiling / coverage
*.profraw
*.profdata

# ===============================
# Ambiente / segredos
# ===============================
.env
.env.*
!.env.example

# ===============================
# IDE / editores
# ===============================
.vscode/
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
.cursor/
*.swp
*.swo
*~

# ===============================
# Sistema
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Logs / temporários / backups
# ===============================
*.log
*.tmp
*.orig
*.bak
